		<string>--nodename</string>
		<string>mac-mini-vm</string>
		<string>--log-level</string>
		<string>debug</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/ubuntu/Library/Logs/com.thesis.virtualization/output.log</string>
	<key>StandardOutPath</key>
	<string>/Users/ubuntu/Library/Logs/com.thesis.virtualization/output.log</string>
