<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>APISERVER_CA_CERT_LOCATION</key>
		<string>/Users/ubuntu/.kube/certs/ca.crt</string>
		<key>APISERVER_CERT_LOCATION</key>
		<string>/Users/ubuntu/.kube/certs/tls.crt</string>
		<key>APISERVER_KEY_LOCATION</key>
		<string>/Users/ubuntu/.kube/certs/tls.key</string>
		<key>DOCKER_HOST</key>
		<string>unix:///Users/ubuntu/.colima/docker.sock</string>
		<key>KUBECONFIG</key>
		<string>/Users/ubuntu/.kube/config</string>
		<key>VZ_BRIDGE_INTERFACE</key>
		<string>vlan0</string>
		<key>VZ_SSH_PASSWORD</key>
		<string>thesis</string>
		<key>VZ_SSH_USER</key>
		<string>thesis</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.thesis.virtualization</string>
