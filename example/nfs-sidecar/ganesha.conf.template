NFS_CORE_PARAM
{
    # Force NFSv4 only to bypass rpcbind (port 111) requirements
    NFS_Protocols = 4;
    
    # Disable unneeded protocols
    MNT_Port = 0;
    Rquota_Port = 0;

    Enable_UDP = false;
    Enable_NLM = false;
    Enable_RQUOTA = false;
}

NFSv4
{
    # Bypass state/recovery issues in stateless containers
    Graceless = true;
    Allow_Numeric_Owners = true;
    Only_Numeric_Owners = true;
}

EXPORT
{
    Export_Id = 1;

    # Directory to export (the PVC mount point inside the container)
    Path = "${SHARED_DIRECTORY}";

    # Mount the export at the NFSv4 pseudo-root so clients can write directly
    Pseudo = "/";

    # Only NFSv4
    Protocols = 4;
    Transports = TCP;
    SecType = sys;

    # Map all traffic to your unprivileged container UID/GID
    Squash = All_Squash;
    Anonymous_Uid = ${CURRENT_UID};
    Anonymous_Gid = ${CURRENT_GID};

    Access_Type = RW;

    # MUST be at EXPORT level (not inside FSAL) for Ganesha 4.x
    Disable_ACL = true;

    # Prevent setgroups() calls which require CAP_SETGID (rootless container has no caps)
    Manage_Gids = false;

    FSAL {
        # VFS = serve the real filesystem (CephFS PVC mounted into the container)
        Name = VFS;
    }
}